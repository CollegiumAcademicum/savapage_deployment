# ── Public URL (Caddy on pod0 terminates TLS) ─────────────────────────────────
PUBLIC_URL=https://print.ca-hd.de

# ── Database: own role + DB inside CArtei's Postgres (setup.sh creates both) ──
DB_HOST=cartei_postgres_1
DB_NAME=savapage
DB_USER=savapage
DB_PASSWORD=CHANGE_ME
# Pool is shared with CArtei's max_connections (default 100) — keep it small.
#DB_POOL_MAX=20

# ── Login: Keycloak (client secret from Clients -> savapage -> Credentials) ───
KEYCLOAK_BASE_URL=https://id.ca-hd.de
KEYCLOAK_REALM=collegium
KEYCLOAK_CLIENT_ID=savapage
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
#KEYCLOAK_BUTTON_TEXT=Login

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Networks whose X-Forwarded-For is trusted (the podman networks Caddy sits on).
#XFF_PROXIES=10.0.0.0/8
